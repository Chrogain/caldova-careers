---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RoleCard from '../components/RoleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { filterJobs, getDepartments, getLocations, sortByNewest } from '../lib/jobs';
import type { Job } from '../types/job';

export const prerender = false;

const entries = await getCollection('jobs');
const allJobs: Job[] = sortByNewest(
    entries.map((entry) => ({ slug: entry.id, ...entry.data })),
);
const selectedDepartment = Astro.url.searchParams.get('department') ?? '';
const selectedLocation = Astro.url.searchParams.get('location') ?? '';
const departments = getDepartments(allJobs);
const locations = getLocations(allJobs);
const jobs = filterJobs(allJobs, {
    department: selectedDepartment,
    location: selectedLocation,
});
---

<Layout title="Caldova Careers — Open roles">
  <div class="py-8">
    <section class="mb-10">
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Build the future of medicine</h1>
      <p class="text-lg text-slate-400 max-w-2xl">
        Caldova is an AI-native pharmaceutical company. Explore our open roles
        and help us bring better treatments to patients faster.
      </p>
    </section>

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/50 p-4">
      <form method="get" action="/" class="grid gap-4 md:grid-cols-[1fr_1fr_auto_auto] md:items-end" data-testid="role-filters">
        <div>
          <label for="department-filter" class="mb-2 block text-sm font-medium text-slate-200">
            Department
          </label>
          <select
            id="department-filter"
            name="department"
            data-testid="department-filter"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-500/40"
          >
            <option value="">All departments</option>
            {departments.map((department) => (
              <option value={department} selected={selectedDepartment === department}>
                {department}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label for="location-filter" class="mb-2 block text-sm font-medium text-slate-200">
            Location
          </label>
          <select
            id="location-filter"
            name="location"
            data-testid="location-filter"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-500/40"
          >
            <option value="">All locations</option>
            {locations.map((location) => (
              <option value={location} selected={selectedLocation === location}>
                {location}
              </option>
            ))}
          </select>
        </div>

        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-lg bg-blue-700 px-4 py-2 font-medium text-white transition hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-900"
          data-testid="apply-filters"
        >
          Apply filters
        </button>

        <a
          href="/"
          class="inline-flex items-center justify-center rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition hover:border-slate-400 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-900"
          data-testid="reset-filters"
        >
          Reset filters
        </a>
      </form>
    </div>

    <h2 class="text-2xl font-medium mb-6 text-slate-100">Open roles</h2>

    {jobs.length === 0 ? (
      <EmptyState text="No roles match the selected filters. Try another department or location." />
    ) : (
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
        data-testid="roles-grid"
      >
        {jobs.map((job) => <RoleCard job={job} />)}
      </div>
    )}
  </div>
</Layout>
